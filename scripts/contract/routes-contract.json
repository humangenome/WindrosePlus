{
  "about": "What every route in server/routes.json answers, with and without a login, on the made-up game folder in scripts/contract/fixture/game. scripts/Test-RouteContract.ps1 runs it against the real server and fails on a route with no entry here. Placeholders: {password}, {token} (the public map token), {port}, {routes_version}. login: none, cookie (the dashboard session), header (X-RCON-Password). save: the answer is written under that name for scripts/contract/check-data-files.py.",
  "routes": {
    "/login": [
      {
        "request": "GET /login",
        "login": "none",
        "status": 200,
        "type": "html",
        "contains": [
          "name=\"password\""
        ]
      },
      {
        "request": "POST /login",
        "login": "none",
        "body": "password=wrong-pass",
        "content_type": "application/x-www-form-urlencoded",
        "status": 200,
        "type": "html",
        "contains": [
          "Invalid password"
        ],
        "no_cookie": true
      },
      {
        "request": "POST /login",
        "login": "none",
        "body": "password={password}",
        "content_type": "application/x-www-form-urlencoded",
        "status": 302,
        "location": "/",
        "headers_contain": {
          "Set-Cookie": "wp_session_{port}="
